BROXY4G_API_USER=admin
BROXY4G_API_PASSWORD=change-me
BROXY4G_DB_PATH=/var/lib/broxy4g/broxy4g.db
BROXY4G_HOST=0.0.0.0
BROXY4G_PORT=8080
# Built frontend directory (set after `npm run build` in frontend/)
BROXY4G_FRONTEND_DIST=/opt/broxy4g/frontend/dist
# Opt-in: allow API auth via query string (?user=…&password=…).
# Fail-closed (default false): only useful for GET-only external tools
# (e.g. Ankabot). Keep it off when not needed — credentials in a URL can
# leak via proxies/browser history (uvicorn access log redacts them).
BROXY4G_ALLOW_QUERY_AUTH=false
# ADB binary (smartphone dongles): must be system-wide — a user-local/home `adb` is unreachable (ProtectHome=true)
BROXY4G_ADB_PATH=adb

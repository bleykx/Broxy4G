# ------------------------------------------------------------------------------
# Broxy4G - environment for the DOCKER COMPOSE deployment.
#
# Copy this file to the REPOSITORY ROOT as `.env` (same directory as
# docker-compose.yml), or simply run deploy/docker-up.sh, which does it for you:
#
#   cp deploy/docker.env.example .env && chmod 600 .env
#
# `docker compose` reads that root `.env` to resolve the ${...} placeholders of
# docker-compose.yml. It does NOT read /etc/broxy4g/broxy4g.env: that file is
# only used by the systemd unit (deploy/broxy4g.service, EnvironmentFile=).
# If Broxy4G is already installed for systemd, /etc/broxy4g/broxy4g.env can be
# copied verbatim instead - extra keys are ignored by compose.
#
# `.env` is gitignored (.gitignore): never commit real credentials.
# ------------------------------------------------------------------------------
BROXY4G_API_USER=admin

# Mandatory. Set a strong value: `change-me` is refused by deploy/docker-up.sh
# and an empty password is a startup error.
BROXY4G_API_PASSWORD=change-me

# Opt-in: allow API auth via query string (?user=...&password=...). Fail-closed
# by default: keep it off unless a GET-only external tool needs it.
BROXY4G_ALLOW_QUERY_AUTH=false
